# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saas_seeder
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Application
APP_ENV=development
APP_URL=http://localhost:8000

# Optional one-click demo access (always disabled when APP_ENV=production)
DEMO_MODE=false
DEMO_SUPER_ADMIN_USERNAME=
DEMO_SUPER_ADMIN_PASSWORD=

# Cookie Configuration
COOKIE_DOMAIN=localhost
# REQUIRED — generate with: php -r "echo bin2hex(random_bytes(32));"
COOKIE_ENCRYPTION_KEY=

# Password Security
# REQUIRED — generate with: php -r "echo bin2hex(random_bytes(32));"
PASSWORD_PEPPER=

# JWT Configuration
# REQUIRED — generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET_KEY=
# Use a distinct key for HMAC hashing rotating refresh tokens.
REFRESH_TOKEN_HASH_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Optional public registration (disabled unless the product flow is complete)
SELF_REGISTRATION_ENABLED=false
# REQUIRED only when SELF_REGISTRATION_ENABLED=true
SIGNUP_TOKEN_HASH_KEY=

# CORS (comma-separated origins, e.g. https://app.example.com,https://admin.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:8000
